{
  "name": "backend",
  "targets": {
    "go-check": {
      "inputs": [
        "go"
      ],
      "dependsOn": [
        {
          "projects": [
            "@flora/web"
          ],
          "target": "build"
        }
      ],
      "command": "test -z \"$(gofmt -l backend)\" && CGO_ENABLED=0 go -C backend vet ./... && CGO_ENABLED=0 go -C backend test -mod=readonly ./..."
    },
    "race": {
      "inputs": [
        "go"
      ],
      "dependsOn": [
        {
          "projects": [
            "@flora/web"
          ],
          "target": "build"
        }
      ],
      "command": "go -C backend test -race -count=1 ./internal/storage ./internal/settings ./internal/auth ./internal/server ./internal/provisioning ./internal/chat ./internal/changes ./internal/githubbroker"
    },
    "binary": {
      "inputs": [
        "go",
        "frontend"
      ],
      "dependsOn": [
        {
          "projects": [
            "@flora/web"
          ],
          "target": "build"
        }
      ],
      "command": "mkdir -p bin && CGO_ENABLED=0 go -C backend build -mod=readonly -trimpath -o ../bin/flora ./cmd/flora"
    },
    "smoke": {
      "inputs": [
        "go",
        "frontend",
        "{workspaceRoot}/scripts/smoke.test.ts"
      ],
      "dependsOn": [
        "binary"
      ],
      "command": "node --test scripts/smoke.test.ts"
    },
    "browser": {
      "inputs": [
        "go",
        "frontend",
        "{workspaceRoot}/florets/docs/**/*",
        "{workspaceRoot}/scripts/florets.browser.ts"
      ],
      "command": "npx playwright install --with-deps --only-shell chromium && FLORA_BROWSER_PREBUILT=1 npm run test:browser && npm run docs:test",
      "dependsOn": [
        "browser-build",
        {
          "projects": [
            "@flora/florets"
          ],
          "target": "styleguide"
        }
      ]
    },
    "browser-build": {
      "cache": true,
      "inputs": [
        "go",
        "webBuild",
        {
          "runtime": "go env GOOS GOARCH GOVERSION"
        }
      ],
      "dependsOn": [
        {
          "projects": [
            "@flora/web"
          ],
          "target": "build"
        }
      ],
      "outputs": [
        "{workspaceRoot}/bin/browser-fixture"
      ],
      "command": "CGO_ENABLED=0 go -C backend build -mod=readonly -tags browserfixture -o ../bin/browser-fixture ./cmd/browser-fixture"
    }
  }
}
