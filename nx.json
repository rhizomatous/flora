{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "neverConnectToCloud": true,
  "namedInputs": {
    "shared": [
      "{workspaceRoot}/*.{json,lock,nix}",
      "{workspaceRoot}/*.config.ts",
      "{workspaceRoot}/Makefile",
      "{workspaceRoot}/.*",
      "{workspaceRoot}/.github/**/*",
      "{workspaceRoot}/**/project.json"
    ],
    "frontend": [
      "webBuild",
      "{workspaceRoot}/web/**/*",
      "{workspaceRoot}/scripts/preview/**/*",
      "{workspaceRoot}/scripts/capture-chat-preview.ts",
      "{workspaceRoot}/scripts/tsconfig.json"
    ],
    "go": [
      "shared",
      "{workspaceRoot}/backend/**/*",
      "!{workspaceRoot}/backend/internal/webassets/dist/**/*"
    ],
    "image": ["shared", "{workspaceRoot}/agent/**/*"],
    "webBuild": [
      "shared",
      "{workspaceRoot}/web/src/**/*",
      "!{workspaceRoot}/web/src/**/*.test.{ts,tsx}",
      "{workspaceRoot}/web/index.html",
      "{workspaceRoot}/web/package.json",
      "{workspaceRoot}/web/tsconfig.json",
      "{workspaceRoot}/web/vite.config.ts",
      "{workspaceRoot}/florets/src/**/*",
      "{workspaceRoot}/florets/package.json",
      "{workspaceRoot}/florets/tsconfig.json"
    ]
  }
}
