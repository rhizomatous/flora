{
  "name": "packaging",
  "targets": {
    "package-check": {
      "inputs": [
        "go",
        "image",
        "{workspaceRoot}/packaging/**/*",
        "webBuild",
        "{workspaceRoot}/scripts/*.py",
        "{workspaceRoot}/scripts/check-{deployment,package,release-linux}.sh",
        "{workspaceRoot}/scripts/{install,package-release,publish-release}.sh"
      ],
      "command": "bash scripts/check-package.sh"
    }
  }
}
