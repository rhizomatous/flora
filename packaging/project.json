{
  "name": "packaging",
  "targets": {
    "package-check": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": [
        "go",
        "image",
        "scripts",
        "{workspaceRoot}/packaging/**/*"
      ],
      "options": {
        "command": "bash scripts/check-package.sh"
      }
    }
  }
}
