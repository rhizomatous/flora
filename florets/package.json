{
  "name": "@flora/florets",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./ai": "./src/ai/index.ts"
  },
  "scripts": {
    "docs:dev": "vite docs --config docs/vite.config.ts",
    "docs:build": "vite build docs --config docs/vite.config.ts",
    "docs:preview": "vite preview docs --config docs/vite.config.ts"
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "1.2.1",
    "@radix-ui/react-dropdown-menu": "2.1.25",
    "@radix-ui/react-icons": "1.3.2",
    "@shadcn/react": "0.3.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "streamdown": "2.7.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "react-dom": "19.3.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "nx": {
    "includedScripts": [],
    "targets": {
      "styleguide": {
        "cache": true,
        "inputs": [
          "shared",
          "{projectRoot}/**/*"
        ],
        "outputs": [
          "{workspaceRoot}/florets/docs-dist"
        ],
        "command": "npm run docs:build"
      }
    }
  }
}
