{
  "name": "@flora/florets",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./ai": "./src/ai/index.ts",
    "./ai/styles.css": "./src/ai/styles.css",
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./lib/utils": "./src/lib/utils.ts"
  },
  "scripts": {
    "docs:dev": "vite docs --config docs/vite.config.ts",
    "docs:build": "vite build docs --config docs/vite.config.ts",
    "docs:preview": "vite preview docs --config docs/vite.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@radix-ui/react-icons": "1.3.2",
    "@shadcn/react": "0.3.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.5.0",
    "lucide-react": "1.70.0",
    "next-themes": "0.4.6",
    "react-day-picker": "10.0.2",
    "react-resizable-panels": "4.19.1",
    "recharts": "3.8.0",
    "shiki": "4.6.0",
    "sonner": "2.0.8",
    "streamdown": "2.7.1",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@ai-sdk/react": "4.0.168",
    "@shadcn/helpers": "0.3.0",
    "ai": "7.0.164",
    "motion": "14.10.1",
    "react-dom": "19.3.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "nx": {
    "includedScripts": [],
    "targets": {
      "styleguide": {
        "cache": true,
        "inputs": [
          "shared",
          "{projectRoot}/**/*"
        ],
        "outputs": [
          "{workspaceRoot}/florets/docs-dist"
        ],
        "command": "npm run docs:build"
      }
    }
  }
}
